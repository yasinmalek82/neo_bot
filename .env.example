NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
DATABASE_URL=postgres://neo_bot:local-development-only@127.0.0.1:55432/neo_bot
WEB_ORIGINS=http://127.0.0.1:4173

# Pilot-only PasarGuard settings. Never commit real values.
PASARGUARD_BASE_URL=https://panel.example.invalid
PASARGUARD_API_KEY=replace-me
PASARGUARD_TIMEOUT_MS=5000
PASARGUARD_MAX_RETRIES=2
PILOT_PROVIDER_CODE=pilot-pasarguard
PILOT_VARIANT_CODE=pilot-direct-variant
PILOT_VARIANT_NAME=Pilot direct variant
PILOT_GROUP_ID=0
PILOT_DURATION_DAYS=30
PILOT_DATA_LIMIT_BYTES=10737418240
PILOT_DEVICE_LIMIT=1
PILOT_ENABLED=false
PROVISIONING_MODE=disabled
# Required only when PROVISIONING_MODE=isolated. It must equal the prepared policy group.
# PROVISIONING_ISOLATED_GROUP_ID=

# Customer bot and card-to-card checkout. Keep disabled until every value is configured.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
# Leave unset for local getUpdates. Set an https URL only when Telegram can reach this process.
# TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram/webhook
# Production compose Caddy site address. Public DNS hostname only, no scheme.
# TELEGRAM_PUBLIC_HOST=
TELEGRAM_ADMIN_IDS=123456789
# Optional cached Telegram photo file IDs. Leave empty until a separately authorized upload.
# The bot keeps commerce available if either image cannot be sent.
TELEGRAM_BRAND_WELCOME_PHOTO_FILE_ID=
TELEGRAM_BRAND_DELIVERY_PHOTO_FILE_ID=

# Optional operator forum. Create a private group, enable Topics, add the bot as admin with
# Manage Topics. The bot creates the purpose topics and stores their IDs. Do not paste IDs in chat.
# TELEGRAM_REPORT_GROUP_CHAT_ID=-1001234567890
# Optional overrides if topics already exist. Leave unset to let the bot create them.
# TELEGRAM_REPORT_TOPIC_NEW_USERS=1
# TELEGRAM_REPORT_TOPIC_ORDERS=2
# TELEGRAM_REPORT_TOPIC_RECEIPTS=3
# TELEGRAM_REPORT_TOPIC_SALES=4
# TELEGRAM_REPORT_TOPIC_RENEWALS=5
# TELEGRAM_REPORT_TOPIC_ERRORS=6
# TELEGRAM_REPORT_TOPIC_DAILY_SUMMARIES=7
# Idle outbox flush while the webhook is quiet. 0 disables the timer; webhook flushes still run.
# TELEGRAM_REPORT_DISPATCH_INTERVAL_MS=15000
# Durable customer-delivery retries always use a positive idle interval.
# TELEGRAM_DELIVERY_DISPATCH_INTERVAL_MS=15000
# Idle flush for expiry/low-traffic reminders and admin broadcasts. 0 disables the timer.
# TELEGRAM_REMINDER_DISPATCH_INTERVAL_MS=15000
# TELEGRAM_BROADCAST_DISPATCH_INTERVAL_MS=15000
# Read-only PasarGuard used-traffic sync for low-volume reminders. 0 disables the timer.
# TELEGRAM_USAGE_SYNC_INTERVAL_MS=60000
# Public bot username without @. Used only to render personal invite start links.
# TELEGRAM_BOT_USERNAME=
