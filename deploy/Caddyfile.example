{$TELEGRAM_PUBLIC_HOST} {
	encode gzip
	log {
		output stdout
		format json
	}

	@api path /telegram/* /health /catalog /customer/*
	handle @api {
		reverse_proxy {$BOT_API_UPSTREAM:127.0.0.1:3100}
	}

	@retired_admin path /console /console/* /admin/*
	handle @retired_admin {
		respond 404
	}

	handle {
		root * {$MINI_APP_DIST:./apps/admin-web/dist/client}
		try_files {path} /index.html
		file_server
	}
}
